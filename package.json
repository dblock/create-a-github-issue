{
  "name": "create-a-github-issue",
  "version": "3.5.2",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dblock/create-a-github-issue.git"
  },
  "scripts": {
    "start": "npx ncc run ./src/index.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "build": "npx ncc build ./src/index.ts",
    "lint": "npm run lint:types && npm run lint:code && npm run lint:markdown",
    "lint:types": "tsc --noEmit",
    "lint:code": "eslint .",
    "lint:markdown": "eslint --config eslint.config-markdown.js \"*.md\""
  },
  "author": "Jason Etcovitch <jasonetco@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@actions/artifact": "^6.3.1",
    "@actions/core": "3.0",
    "@actions/github": "^9.0.0",
    "@actions/glob": "^0.7.0",
    "@octokit/plugin-throttling": "^11.0.5",
    "front-matter": "4.0.2",
    "nunjucks": "3.2.4",
    "nunjucks-date-filter": "0.1.1"
  },
  "devDependencies": {
    "@cspell/dict-en_us": "^4.4.43",
    "@cspell/dict-software-terms": "^5.4.11",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@tsconfig/recommended": "^1.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "^24.19.4",
    "@types/nunjucks": "3.2.6",
    "@vercel/ncc": "0.45.0",
    "eslint": "^10.15.0",
    "eslint-plugin-markdown-preferences": "^0.43.0",
    "eslint-plugin-markdown-preferences-paragraph": "^0.2.0",
    "eslint-plugin-prose-spellcheck": "^0.1.2",
    "globals": "^17.14.0",
    "jest": "30.5.2",
    "npm-package-release": "0.3.0",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "jest": {
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "transform": {
      ".+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    }
  }
}
